{
  "name": "Marketplace",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "docker:dev:up": "docker compose -f compose.yaml -f compose.dev.yaml --env-file .env up --build -d",
    "docker:dev:down": "docker compose -f compose.yaml -f compose.dev.yaml --env-file .env down",
    "docker:prod:up": "docker compose -f compose.yaml -f compose.prod.yaml --env-file .env.prod up --build -d",
    "docker:prod:down": "docker compose -f compose.yaml -f compose.prod.yaml --env-file .env.prod down",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "build": "nest build",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "npx prettier . --check",
    "format:fix": "npx prettier . --write",
    "test-unit": "jest --config ./test/jest-unit.json",
    "test-integration": "jest --config ./test/jest-integration.json",
    "db:migration:initial": "docker compose -f compose.yaml -f compose.dev.yaml exec app npx mikro-orm migration:create --initial",
    "db:migration:create": "docker compose -f compose.yaml -f compose.dev.yaml exec app npx mikro-orm migration:create",
    "db:migration:up": "docker compose -f compose.yaml -f compose.dev.yaml exec app npx mikro-orm migration:up",
    "db:migration:down": "docker compose -f compose.yaml -f compose.dev.yaml exec app npx mikro-orm migration:down",
    "db:seed": "docker compose -f compose.yaml -f compose.dev.yaml exec app npx mikro-orm seeder:run"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.2",
    "@mikro-orm/entity-generator": "^6.6.2",
    "@mikro-orm/migrations": "^6.6.2",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.6.2",
    "@mikro-orm/reflection": "^6.6.2",
    "@mikro-orm/seeder": "^6.6.2",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "joi": "^18.0.2",
    "pg": "^8.16.3",
    "process": "^0.11.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mikro-orm/cli": "^6.6.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
